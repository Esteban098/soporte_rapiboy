# ---------------------------------------------------------------------------
# Fuente de datos
# ---------------------------------------------------------------------------

# Id del Google Sheet: el tramo que va entre /d/ y /edit en la URL del documento.
# La app lo lee SOLO desde el servidor, así que esta URL nunca llega al navegador.
SHEET_ID=1V3e9BSHV72vz15g2pKWCvMgnHF9QNMfaMunAjb5FC4E

# Poné "fixture" para trabajar con los CSV de web/fixtures en vez del sheet.
# Sin SHEET_ID cargado, la app usa fixtures automáticamente.
SHEET_MODE=

# Nombre de la pestaña viva, la que tiene los casos del mes en curso.
# Si se omite, se usa "Mensual".
SHEET_TAB_MENSUAL=

# Flujos de n8n que rearman el libro, separados por coma y en el orden en que
# deben correr. Van las *Production URL* del nodo Webhook de cada flujo, no la
# URL del editor (https://.../workflow/...), que no ejecuta nada.
# Ejemplo: N8N_WEBHOOKS=https://linux.rapitools.com.ar/webhook/abc,https://linux.rapitools.com.ar/webhook/def
N8N_WEBHOOKS=

# Cuánto esperar a cada flujo antes de darlo por colgado, en milisegundos.
N8N_TIMEOUT_MS=120000

# Cada cuántos segundos se vuelve a leer el sheet. El libro se actualiza una vez
# por día, así que una hora es de sobra.
SHEET_REVALIDATE=3600

# ---------------------------------------------------------------------------
# Acceso
# ---------------------------------------------------------------------------

# Secreto de sesión. Generalo con: openssl rand -base64 32
AUTH_SECRET=

# Credenciales de Google OAuth (consola de Google Cloud > Credenciales).
# La URI de redirección autorizada es https://TU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quién puede entrar. Se puede usar un dominio, una lista de correos, o las dos.
# Si no se configura ninguna, no entra nadie.
ALLOWED_EMAIL_DOMAIN=
ALLOWED_EMAILS=
