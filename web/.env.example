# ---------------------------------------------------------------------------
# Fuente de datos
# ---------------------------------------------------------------------------

# Qué origen usa el tablero: "supabase", "sheet" o "fixture".
# Si se deja vacío se elige solo: manda Supabase si están sus credenciales,
# si no el sheet, y si no hay nada los fixtures. Ponerlo explícito sirve para
# volver al sheet en el acto si la base falla, sin borrar credenciales.
ORIGEN_DATOS=

# ---------------------------------------------------------------------------
# Supabase (origen actual)
# ---------------------------------------------------------------------------

# Project Settings > API. La URL es como https://xxxxx.supabase.co
SUPABASE_URL=

# La service_role key, NO la anon. Saltea RLS, así que solo se usa desde el
# servidor y nunca llega al navegador. Si se filtra, rotala desde ese panel.
SUPABASE_SERVICE_KEY=

# Nombres de las tablas y del bucket, si no son los que trae el código.
SUPABASE_TABLA_MENSUAL=
SUPABASE_TABLA_MENSUAL_HISTORICO=
SUPABASE_TABLA_AYER=
SUPABASE_TABLA_CANCELADOS=
SUPABASE_TABLA_CANCELADOS_HISTORICO=
SUPABASE_TABLA_PERFILES=
SUPABASE_TABLA_SEGUIMIENTO=
SUPABASE_TABLA_COLECTAS_ASIGNACION=
SUPABASE_TABLA_COLECTAS=
SUPABASE_BUCKET_SEGUIMIENTO=

# Cuánto vive una URL firmada de adjunto, en segundos. Por defecto una hora.
SUPABASE_FIRMA_SEGUNDOS=

# ---------------------------------------------------------------------------
# Google Sheet (origen anterior, se mantiene como respaldo)
# ---------------------------------------------------------------------------

# Id del Google Sheet: el tramo que va entre /d/ y /edit en la URL del documento.
# La app lo lee SOLO desde el servidor, así que esta URL nunca llega al navegador.
SHEET_ID=1V3e9BSHV72vz15g2pKWCvMgnHF9QNMfaMunAjb5FC4E

# Gid de cada pestaña, como "Mensual:1701594461,Ayer:0". Solo hace falta si se
# recrea una pestaña y cambia su número; los actuales están en src/lib/config.ts.
# El gid se ve en la URL al abrir la pestaña: ...#gid=1701594461
SHEET_GIDS=

# Poné "fixture" para trabajar con los CSV de web/fixtures en vez del sheet.
# Sin SHEET_ID cargado, la app usa fixtures automáticamente.
SHEET_MODE=

# Nombre de la pestaña viva, la que tiene los casos del mes en curso.
# Si se omite, se usa "Mensual".
SHEET_TAB_MENSUAL=

# Flujos de n8n, separados por coma y en el orden en que deben correr. Van las
# *Production URL* del nodo Webhook de cada flujo, no la URL del editor
# (https://.../workflow/...), que no ejecuta nada.
#
# Hay tres botones Actualizar y cada uno dispara los suyos:
#
#   N8N_WEBHOOKS                        el de la barra: refresca el mes en curso
#   N8N_WEBHOOKS_HISTORICO              el de Histórico: meses ya cerrados
#   N8N_WEBHOOKS_CANCELADOS_HISTORICO   el de Cancelados históricos
#   N8N_WEBHOOKS_COLECTAS               el de Colectas
#
# Los de histórico pueden quedar vacíos: el botón avisa que no hay flujos y la
# pantalla sigue mostrando lo que ya está guardado.
# Ejemplo: N8N_WEBHOOKS=https://linux.rapitools.com.ar/webhook/abc,https://.../def
N8N_WEBHOOKS=
N8N_WEBHOOKS_HISTORICO=
N8N_WEBHOOKS_CANCELADOS_HISTORICO=
N8N_WEBHOOKS_COLECTAS=

# Cuánto esperar a cada flujo antes de darlo por colgado, en milisegundos.
N8N_TIMEOUT_MS=120000

# Cada cuántos segundos se vuelven a leer los datos, valga el origen que valga.
# La fuente se actualiza una vez por día, así que una hora es de sobra; el botón
# Refrescar fuerza una lectura nueva cuando no se quiere esperar.
SHEET_REVALIDATE=3600

# ---------------------------------------------------------------------------
# Acceso
# ---------------------------------------------------------------------------

# Secreto de sesión. Generalo con: openssl rand -base64 32
AUTH_SECRET=

# Credenciales de Google OAuth (consola de Google Cloud > Credenciales).
# La URI de redirección autorizada es https://TU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quién puede entrar. Se puede usar un dominio, una lista de correos, o las dos.
# Si no se configura ninguna, no entra nadie.
ALLOWED_EMAIL_DOMAIN=
ALLOWED_EMAILS=

# Abre el tablero sin login. SOLO fuera de producción y solo con el valor "1".
# Es la salida de emergencia si alguien queda afuera antes de correr
# supabase/perfiles.sql. En producción no tiene efecto.
AUTH_ABIERTO=

# ---------------------------------------------------------------------------
# Resumen de los reportes de seguimiento (opcional)
# ---------------------------------------------------------------------------

# Sin esta clave el tablero sigue tomando reportes y los guarda sin resumir.
# La pantalla muestra el comentario original cuando falta el resumen.
OPENAI_API_KEY=

# Por defecto gpt-4o-mini, que para resumir dos oraciones sobra.
OPENAI_MODEL=
