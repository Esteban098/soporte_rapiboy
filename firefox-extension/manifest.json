{
  "manifest_version": 2,
  "name": "Rapiboy · Datos de tienda",
  "version": "2.0.0",
  "description": "Carga en el tablero de soporte la información de tienda seleccionada en Firefox.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "https://linux.rapitools.com.ar/*"
  ],
  "icons": {
    "16": "icons/rapiboy.png",
    "32": "icons/rapiboy.png",
    "48": "icons/rapiboy.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "datos-tienda@rapiboy.com",
      "strict_min_version": "109.0"
    }
  }
}
