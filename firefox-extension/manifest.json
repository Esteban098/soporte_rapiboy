{
  "manifest_version": 2,
  "name": "Rapiboy · Herramientas",
  "version": "3.0.3",
  "description": "Asistente operativo y carga de datos de tienda para Rapiboy.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "https://linux.rapitools.com.ar/*",
    "https://web.whatsapp.com/*",
    "https://rapiboy.com/*",
    "https://*.rapiboy.com/*",
    "https://soporte-rapiboy.vercel.app/*"
  ],
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*", "https://rapiboy.com/*", "https://*.rapiboy.com/*"],
    "js": ["assistant-panel.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": ["assistant-panel.css"],
  "icons": {
    "16": "icons/rapiboy-16.png",
    "32": "icons/rapiboy-32.png",
    "48": "icons/rapiboy-48.png",
    "96": "icons/rapiboy-96.png",
    "128": "icons/rapiboy-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "datos-tienda@rapiboy.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "websiteActivity", "personallyIdentifyingInfo"]
      }
    }
  }
}
