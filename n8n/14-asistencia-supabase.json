            { "id": "fd8c785a-14fb-4bff-b941-d59a9762b60d", "name": "idPoll", "value": "={{ $json.body.payload.poll.id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "7f1bb988-08e4-4070-b018-b42b34bbd9cf",
      "name": "Normalizar voto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-280, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ASISTENCIA_PLATAFORMA_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.ASISTENCIA_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { telefono: $json.telefono, voto: $json.voto, timestamp: $json.timestamp, idPoll: $json.idPoll } }}",
        "options": { "timeout": 15000 }
      },
      "id": "efea9a0c-2cb7-4a2e-96bd-56071d6d0614",
      "name": "Guardar voto en plataforma",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 260],
      "notes": "La plataforma resuelve teléfono -> IdMotoboy dentro de Supabase y hace el upsert de la jornada. No lleva credenciales de Supabase ni escribe Sheets."
    }
