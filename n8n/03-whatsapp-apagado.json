    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Demorados sin entregar, directo de la base.\n--\n-- Reemplaza a la hoja DemoradoNoEntregado y a la rama de las 9am que la\n-- rearmaba: el corte es el mismo que usa el tablero, más de dos días sin\n-- moverse y todavía abierto, así que las dos listas no pueden discrepar.\nselect id, repartidor, destino, fecha_programado\n  from public.mensual\n where caso = 'Abierto'\n   and estado = 'Pedido no entregado'\n   and fecha_programado < current_date - interval '2 days'\n order by repartidor, fecha_programado;",
        "options": {}
