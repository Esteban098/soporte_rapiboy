    {
      "parameters": {
        "jsCode": "// Un mensaje por repartidor, con todas sus direcciones juntas.\nconst grupos = {};\nfor (const { json: r } of $input.all()) {\n  const clave = r.Repartidor ?? r.repartidor;\n  if (!clave) continue;\n  grupos[clave] ??= { Repartidor: clave, Id_Grupo: r['Id Grupo'] ?? r.Id_Grupo,\n                      FechaProgramado: r.fecha_programado, Direcciones: [], Ids: [] };\n  if (r.destino) grupos[clave].Direcciones.push(r.destino);\n  if (r.id) grupos[clave].Ids.push(r.id);\n}\nreturn Object.values(grupos).map((g) => ({\n  json: { ...g, Direcciones: g.Direcciones.join('\\n'), Ids: g.Ids.join(', ') },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        700
      ],
